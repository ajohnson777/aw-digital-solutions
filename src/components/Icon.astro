---
// Authored icon set: 24px grid, 1.5 stroke, round joins.
const { name, label } = Astro.props;
const paths = {
  arrow: '<path d="M4 12h15M13 6l6 6-6 6"/>',
  close: '<path d="M6 6l12 12M18 6L6 18"/>',
  check: '<path d="M4.5 12.5l5 5 10-11"/>',
  cross: '<path d="M7 7l10 10M17 7L7 17"/>',
  alert: '<circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.5M12 16.4v.1"/>',
  // A page frame with a set square drafted inside it
  build: '<rect x="3" y="4" width="18" height="16" rx="1"/><path d="M3 8h18"/><path d="M7 17V11.5l5.5 5.5z"/><path d="M15 12h3M15 15h3"/>',
  // Two sheets: the old one, and the revision drawn over it
  redesign: '<rect x="3" y="7" width="13" height="13" rx="1" stroke-dasharray="2 2"/><rect x="8" y="3" width="13" height="13" rx="1"/><path d="M11 9.5h7M11 12.5h4"/>',
  // A dial being kept in tune
  manage: '<circle cx="12" cy="12" r="8.5"/><path d="M12 12l4-3.5"/><path d="M12 3.5v2M20.5 12h-2M12 20.5v-2M3.5 12h2"/><circle cx="12" cy="12" r="1.2"/>',
  modern: '<path d="M4 20V9l8-5 8 5v11"/><path d="M4 20h16"/><path d="M9 20v-6h6v6"/>',
  fast: '<path d="M13 3L5 13.5h6L10 21l8-10.5h-6z"/>',
  accessible: '<circle cx="12" cy="4.8" r="1.6"/><path d="M5 8.5c2.4.7 4.7 1 7 1s4.6-.3 7-1"/><path d="M12 9.5v4.5l-3 6.5M12 14l3 6.5"/>',
};
---
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'} role={label ? 'img' : undefined} aria-label={label} focusable="false"
  set:html={paths[name]} />
