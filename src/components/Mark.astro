---
// The AW mark: the A's right leg is the W's first stroke.
const { size = 40, accent = "var(--cobalt, #2335c8)" } = Astro.props;
---
<svg viewBox="0 0 36 32" width={size} fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false">
  <path d="M3 27L11 5L17 27L22 13L27 27L33 5" />
  <path d="M6.2 19.2H14.6" stroke={accent} />
</svg>
